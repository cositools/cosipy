                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                XTENSION= 'BINTABLE'           / binary table extension                         BITPIX  =                    8 / array data type                                NAXIS   =                    2 / number of array dimensions                     NAXIS1  =                   72 / length of dimension 1                          NAXIS2  =                    4 / length of dimension 2                          PCOUNT  =                    0 / number of group parameters                     GCOUNT  =                    1 / number of groups                               TFIELDS =                    6 / number of table fields                         TTYPE1  = 'TimeStamp'                                                           TFORM1  = 'D       '                                                            TTYPE2  = 'XPointings'                                                          TFORM2  = '2D      '                                                            TUNIT2  = 'deg     '                                                            TDIM2   = '(2)     '                                                            